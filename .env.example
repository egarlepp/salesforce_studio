# Server
PORT=3000

# Salesforce Connected App (Setup > App Manager > New Connected App > Enable OAuth Settings)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Use https://test.salesforce.com for sandboxes
SF_LOGIN_URL=https://login.salesforce.com
SF_CALLBACK_URL=http://localhost:3000/oauth/callback

# Session cookie signing secret (any long random string)
SESSION_SECRET=change-me-to-a-random-string

# SQLite database file location
DB_PATH=./data/app.db
